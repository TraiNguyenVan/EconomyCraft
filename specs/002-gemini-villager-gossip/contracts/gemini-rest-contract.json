{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeminiGenerateContentContract",
  "description": "REST contract for Gemini v1beta generateContent API with structured JSON output, secure header authentication, and low-latency thinking config",
  "endpoint": "POST https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent",
  "headers": {
    "x-goog-api-key": "{apiKey}",
    "Content-Type": "application/json"
  },
  "request": {
    "type": "object",
    "required": ["contents", "generationConfig", "safetySettings"],
    "properties": {
      "system_instruction": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" }
              },
              "required": ["text"]
            }
          }
        }
      },
      "contents": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "parts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": { "type": "string" }
                },
                "required": ["text"]
              }
            }
          },
          "required": ["parts"]
        }
      },
      "safetySettings": {
        "type": "array",
        "description": "Safety filter thresholds set to BLOCK_ONLY_HIGH to avoid false positives on fantasy economy terms",
        "items": {
          "type": "object",
          "required": ["category", "threshold"],
          "properties": {
            "category": { "type": "string" },
            "threshold": { "type": "string", "const": "BLOCK_ONLY_HIGH" }
          }
        }
      },
      "generationConfig": {
        "type": "object",
        "required": ["response_mime_type", "response_schema"],
        "properties": {
          "response_mime_type": { "type": "string", "const": "application/json" },
          "temperature": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
          "maxOutputTokens": { "type": "integer", "minimum": 128, "maximum": 4096 },
          "thinkingConfig": {
            "type": "object",
            "properties": {
              "thinkingBudget": { "type": "integer", "const": 0 }
            }
          },
          "response_schema": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "OBJECT" },
              "properties": {
                "type": "object"
              },
              "required": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  },
  "response": {
    "type": "object",
    "required": ["candidates"],
    "properties": {
      "candidates": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["content"],
          "properties": {
            "content": {
              "type": "object",
              "required": ["parts"],
              "properties": {
                "parts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["text"],
                    "properties": {
                      "text": {
                        "type": "string",
                        "description": "Serialized JSON string matching the defined response_schema"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
